{
  "name": "ridge-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:copy": "node scripts/check-published-copy.mjs",
    "guard": "npm run typecheck && npm run lint && npm run test && npm run check:copy && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-ridge": "file:./eslint-plugin-ridge",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
