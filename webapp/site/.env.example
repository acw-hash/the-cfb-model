# Ridge site — private preview (W7). Copy to .env.local; never commit secrets.
#
# ACCESS POSTURE (required before any deploy that is reachable):
# 1. Vercel Deployment Protection ON (Standard Protection / password / SSO).
# 2. X-Robots-Tag + robots.txt already noindex via next.config + app/robots.ts.
# 3. Do NOT attach a public custom domain or submit to search engines (W8).
#
# Artifact source — NEVER leave unset on Vercel (loader refuses fixtures there).
ARTIFACT_SOURCE=r2

# Private R2 (server-side credential). Prefer a READ-ONLY API token, not the
# workstation write key. World-readable public buckets are out of scope for W7.
R2_BUCKET=
R2_ACCOUNT_ID=
# Or set the full S3 endpoint instead of account id:
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

# Shared secret for POST /api/revalidate (must match workstation WEBAPP_REVALIDATE_SECRET)
WEBAPP_REVALIDATE_SECRET=

# Dev-only local fixtures (default when ARTIFACT_SOURCE unset and not on Vercel):
# ARTIFACT_SOURCE=fixtures
# ARTIFACT_BASE_PATH=../fixtures
